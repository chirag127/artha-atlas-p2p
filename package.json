{
  "name": "artha-atlas-p2p",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "An independent educational research platform covering Indian peer-to-peer lending, NBFC-P2P regulation, credit underwriting, portfolio returns, borrower defaults, recoveries, taxation, risk analysis and quantitative lending calculators.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.8",
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.4.2",
    "katex": "^0.16.21",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "pagefind": "^1.3.0",
    "vitest": "^3.0.7"
  }
