---
import BaseLayout from './BaseLayout.astro';
import { formatUrl } from '../lib/urls';
import { getSourceById } from '../data/sources';
import { CONTENT_SERIES } from '../data/taxonomy';

interface Props {
  title: string;
  description: string;
  series: string;
  seriesOrder: number;
  pubDate: Date;
  lastReviewed?: Date;
  author: string;
  category: string;
  readingTimeMinutes: number;
  sources?: string[];
  tags?: string[];
  mermaid?: boolean;
  math?: boolean;
}

const {
  title,
  description,
  series,
  seriesOrder,
  pubDate,
  lastReviewed,
  author,
  category,
  readingTimeMinutes,
  sources = [],
  tags = [],
  mermaid = false,
  math = false,
} = Astro.props;

const currentSeries = CONTENT_SERIES.find((s) => s.slug === series);
const resolvedSources = sources.map((id) => getSourceById(id)).filter(Boolean);
---

<BaseLayout title={`${title} — ArthaAtlas P2P`} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-medium overflow-x-auto whitespace-nowrap">
      <a href={formatUrl('/')} class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
      <span>/</span>
      <a href={formatUrl('/articles')} class="hover:text-brand-600 dark:hover:text-brand-400">Articles</a>
      <span>/</span>
      {currentSeries && (
        <>
          <a href={formatUrl(`/series/${currentSeries.slug}`)} class="hover:text-brand-600 dark:hover:text-brand-400">
            {currentSeries.title}
          </a>
          <span>/</span>
        </>
      )}
      <span class="text-slate-800 dark:text-slate-200 truncate">Module #{seriesOrder}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        {currentSeries && (
          <a
            href={formatUrl(`/series/${currentSeries.slug}`)}
            class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-100 dark:bg-brand-950/80 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-900"
          >
            Series: {currentSeries.title} (Part {seriesOrder} of 10)
          </a>
        )}
        <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
          ⏱️ {readingTimeMinutes} min read
        </span>
        <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
          ✓ Peer-Reviewed Research
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight mb-4">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {description}
      </p>

      <!-- Metadata & Author Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-slate-100 dark:border-slate-850 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center font-bold text-slate-700 dark:text-slate-300">
            CS
          </div>
          <div>
            <div class="font-bold text-slate-900 dark:text-white">{author}</div>
            <div class="text-[11px]">Independent Credit Researcher & Developer</div>
          </div>
        </div>
        <div class="flex items-center gap-4 text-right">
          <div>
            <div><strong>Published:</strong> {new Date(pubDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
            {lastReviewed && (
              <div class="text-[11px] text-emerald-600 dark:text-emerald-400">
                <strong>Reviewed:</strong> {new Date(lastReviewed).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
              </div>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- Main Article Body -->
    <article class="prose dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 leading-relaxed">
      <slot />
    </article>

    <!-- Verified Sources Citation Box -->
    {resolvedSources.length > 0 && (
      <div class="mt-14 p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">📚</span>
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
            Primary Regulatory & Statutory Sources Cited
          </h3>
        </div>
        <div class="space-y-4">
          {resolvedSources.map((source: any) => (
            <div class="text-xs p-3.5 rounded-xl bg-white dark:bg-navy-900 border border-slate-200/80 dark:border-slate-800">
              <div class="font-bold text-slate-900 dark:text-white">
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-brand-600 dark:text-brand-400 hover:underline">
                  {source.title} &rarr;
                </a>
              </div>
              <div class="text-slate-500 dark:text-slate-400 mt-1">
                <strong>Publisher:</strong> {source.publisher} &bull; <strong>Applicable:</strong> {source.applicablePeriod}
              </div>
              <div class="mt-2 text-slate-600 dark:text-slate-300">
                <strong>Key Claims Supported:</strong>
                <ul class="list-disc list-inside mt-1 space-y-0.5">
                  {source.claimsSupported.slice(0, 3).map((claim: string) => (
                    <li>{claim}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Tags Pill Row -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-8 pt-6 border-t border-slate-200 dark:border-slate-800">
        <span class="text-xs font-semibold text-slate-500 self-center mr-1">Tags:</span>
        {tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-mono">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Author Support & BuyMeACoffee Callout -->
    <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 dark:from-amber-950/20 dark:to-orange-950/20 border border-amber-200/80 dark:border-amber-900/50 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-white">Independent, Unsponsored Research</h4>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 max-w-lg">
          ArthaAtlas P2P accepts zero platform sponsorships, affiliate commissions, or advertising revenue. If this research helped clarify your credit risk, consider supporting the publication.
        </p>
      </div>
      <a
        href="https://buymeacoffee.com/chirag127"
        target="_blank"
        rel="noopener noreferrer"
        class="whitespace-nowrap px-4 py-2 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs hover:bg-amber-400 transition-colors shadow-sm"
      >
        ☕ Buy Me A Coffee
      </a>
    </div>

  </div>
</BaseLayout>

{mermaid && (
  <script is:inline type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    const isDark = document.documentElement.classList.contains('dark');
    mermaid.initialize({
      startOnLoad: true,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'loose',
    });
  </script>
)}
