---
import { formatUrl } from '../../lib/urls';
---

<footer class="bg-white dark:bg-navy-950 border-t border-slate-200 dark:border-slate-800 mt-20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-brand-700 to-emerald-500 flex items-center justify-center text-white font-extrabold text-sm">
            AA
          </div>
          <span class="font-extrabold text-lg text-slate-900 dark:text-white">ArthaAtlas P2P</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-4 max-w-sm">
          An independent educational research platform dedicated to Indian peer-to-peer lending, NBFC-P2P regulatory frameworks, quantitative credit underwriting, realised portfolio returns, default mechanics, and taxation.
        </p>
        <div class="text-xs text-slate-500 dark:text-slate-400 space-y-1">
          <div><strong>Author & Lead Researcher:</strong> Chirag Singhal</div>
          <div><strong>Contact Email:</strong> <a href="mailto:chirag@oriz.in" class="text-brand-600 dark:text-brand-400 hover:underline">chirag@oriz.in</a></div>
          <div><strong>Facebook:</strong> <a href="https://facebook.com/singhal127" target="_blank" rel="noopener" class="text-brand-600 dark:text-brand-400 hover:underline">singhal127</a></div>
          <div class="pt-2">
            <a
              href="https://buymeacoffee.com/chirag127"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-700 dark:text-amber-300 font-semibold hover:bg-amber-500/20 transition-colors border border-amber-500/20"
            >
              ☕ Buy Me a Coffee (Support Research)
            </a>
          </div>
        </div>
      </div>

      <!-- Research Series Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          Core Research
        </h4>
        <ul class="text-xs space-y-2 text-slate-600 dark:text-slate-400">
          <li><a href={formatUrl('/series/p2p-fundamentals')} class="hover:text-brand-600 dark:hover:text-brand-400">P2P Fundamentals</a></li>
          <li><a href={formatUrl('/series/rbi-regulation')} class="hover:text-brand-600 dark:hover:text-brand-400">RBI Regulation & Circulars</a></li>
          <li><a href={formatUrl('/series/credit-risk')} class="hover:text-brand-600 dark:hover:text-brand-400">Credit Risk & Underwriting</a></li>
          <li><a href={formatUrl('/series/returns-and-fees')} class="hover:text-brand-600 dark:hover:text-brand-400">Returns, XIRR & Fee Leakage</a></li>
          <li><a href={formatUrl('/series/defaults-and-recoveries')} class="hover:text-brand-600 dark:hover:text-brand-400">Defaults & Legal Recovery</a></li>
        </ul>
      </div>

      <!-- Advanced Centers -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          Specialised Hubs
        </h4>
        <ul class="text-xs space-y-2 text-slate-600 dark:text-slate-400">
          <li><a href={formatUrl('/series/portfolio-analytics')} class="hover:text-brand-600 dark:hover:text-brand-400">Portfolio Analytics (HHI)</a></li>
          <li><a href={formatUrl('/series/taxation')} class="hover:text-brand-600 dark:hover:text-brand-400">Indian Taxation (Sec 56/57)</a></li>
          <li><a href={formatUrl('/series/platform-research')} class="hover:text-brand-600 dark:hover:text-brand-400">Platform Due Diligence</a></li>
          <li><a href={formatUrl('/series/compare-investments')} class="hover:text-brand-600 dark:hover:text-brand-400">P2P vs Bank FDs & Bonds</a></li>
          <li><a href={formatUrl('/series/investor-behaviour')} class="hover:text-brand-600 dark:hover:text-brand-400">Investor Behaviour & Biases</a></li>
        </ul>
      </div>

      <!-- Calculators & Data -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          Tools & References
        </h4>
        <ul class="text-xs space-y-2 text-slate-600 dark:text-slate-400">
          <li><a href={formatUrl('/calculators')} class="hover:text-brand-600 dark:hover:text-brand-400 font-semibold">5 Quantitative Calculators</a></li>
          <li><a href={formatUrl('/roadmap')} class="hover:text-brand-600 dark:hover:text-brand-400">300+ Topic Roadmap</a></li>
          <li><a href={formatUrl('/sources')} class="hover:text-brand-600 dark:hover:text-brand-400">Official Source Register</a></li>
          <li><a href={formatUrl('/methodology')} class="hover:text-brand-600 dark:hover:text-brand-400">Research Methodology</a></li>
          <li><a href={formatUrl('/about')} class="hover:text-brand-600 dark:hover:text-brand-400">About the Publication</a></li>
        </ul>
      </div>
    </div>

    <!-- Statutory Disclaimer Banner -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
      <div class="bg-slate-50 dark:bg-slate-900/60 p-4 rounded-xl border border-slate-200 dark:border-slate-800 mb-6">
        <strong class="text-slate-800 dark:text-slate-200 block mb-1">STATUTORY FINANCIAL & REGULATORY DISCLAIMER:</strong>
        ArthaAtlas P2P is an independent financial education and research publication. It is not an NBFC, NBFC-P2P, bank, investment advisor, or payment aggregator. It does not solicit, originate, broker, or service loans, nor does it hold investor funds. Peer-to-peer lending in India involves substantial credit risk, including the potential total loss of invested capital. P2P loans are strictly unsecured; they are NOT covered by DICGC deposit insurance and do NOT carry sovereign or platform credit guarantees. Historical performance is not indicative of future returns. Nothing on this website constitutes legal, tax, or investment advice. Always consult a licensed Chartered Accountant or SEBI-registered advisor before committing risk capital.
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
        <div>
          &copy; {new Date().getFullYear()} ArthaAtlas P2P (Author: Chirag Singhal). All rights reserved.
        </div>
        <div class="flex items-center gap-4">
          <a href={formatUrl('/sitemap-index.xml')} class="hover:underline">XML Sitemap</a>
          <span>&bull;</span>
          <a href="https://github.com/chirag127/artha-atlas-p2p" target="_blank" rel="noopener" class="hover:underline">GitHub Repository</a>
          <span>&bull;</span>
          <a href="https://buymeacoffee.com/chirag127" target="_blank" rel="noopener" class="hover:underline">BuyMeACoffee</a>
        </div>
      </div>
    </div>
  </div>
</footer>
