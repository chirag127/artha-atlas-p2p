---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvestmentComparisonCalculator from '../../components/calculators/InvestmentComparisonCalculator';
import { ASSET_CLASSES } from '../../lib/finance/comparison';
import { formatUrl } from '../../lib/urls';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const compareArticles = allArticles
  .filter((a) => a.data.series === 'compare-investments')
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);
---

<BaseLayout
  title="P2P vs Bank FDs, Debt Mutual Funds, Corporate Bonds & REITs — ArthaAtlas P2P"
  description="Multi-asset risk-adjusted comparison: Compare peer-to-peer lending against Scheduled Bank Fixed Deposits, Sovereign T-Bills, Debt Mutual Funds, Listed Bonds, and REITs."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Hero Header -->
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-900">
          Multi-Asset Research Hub
        </span>
        <span class="text-xs text-slate-500">Risk-Adjusted Spread Analysis</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        P2P Lending vs Alternative Fixed Income Assets
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300 mt-2 max-w-3xl leading-relaxed">
        High nominal yield means nothing without assessing default probability, liquidity lock-in, and statutory capital protection. Compare Indian P2P lending against traditional and market-linked cash instruments.
      </p>
    </div>

    <!-- Comparative Matrix Table -->
    <div class="mb-14">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
        Master Asset Class Comparison Matrix
      </h2>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-navy-900 shadow-sm">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 uppercase font-semibold">
            <tr>
              <th class="px-4 py-3.5">Asset Class</th>
              <th class="px-4 py-3.5">Nominal Yield</th>
              <th class="px-4 py-3.5">Credit Default Risk</th>
              <th class="px-4 py-3.5">Principal Protection</th>
              <th class="px-4 py-3.5">Liquidity & Exit</th>
              <th class="px-4 py-3.5">Taxation Basis</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-200">
            {ASSET_CLASSES.map((asset) => (
              <tr class={asset.id === 'p2p-lending' ? 'bg-blue-50/40 dark:bg-blue-950/20 font-semibold' : ''}>
                <td class="px-4 py-3 font-bold">
                  {asset.name}
                  {asset.id === 'p2p-lending' && (
                    <span class="block text-[10px] text-brand-600 font-mono">Benchmark Focus</span>
                  )}
                </td>
                <td class="px-4 py-3 font-mono font-bold text-brand-600 dark:text-brand-400">
                  {asset.nominalYieldRange[0]}% – {asset.nominalYieldRange[1]}%
                </td>
                <td class="px-4 py-3">
                  <span class={`px-2 py-0.5 rounded text-[11px] font-bold ${
                    asset.defaultRisk === 'High' ? 'bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300' :
                    asset.defaultRisk === 'Moderate' ? 'bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300' :
                    'bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300'
                  }`}>
                    {asset.defaultRisk}
                  </span>
                </td>
                <td class="px-4 py-3 text-slate-600 dark:text-slate-400 text-[11px]">
                  {asset.principalProtection}
                </td>
                <td class="px-4 py-3 text-slate-600 dark:text-slate-400 text-[11px]">
                  {asset.liquidity}
                </td>
                <td class="px-4 py-3 text-slate-600 dark:text-slate-400 text-[11px]">
                  {asset.taxTreatment}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Interactive Comparison Calculator -->
    <div class="mb-14">
      <InvestmentComparisonCalculator client:load />
    </div>

    <!-- Comparison Series Modules Grid -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">
            10 Researched Comparative Modules
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Empirical comparisons against Bank FDs, Sovereign G-Secs, Debt MFs, Corporate NCDs, and REITs.
          </p>
        </div>
        <a href={formatUrl('/series/compare-investments')} class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">
          View Complete Series &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {compareArticles.map((art) => (
          <div class="p-5 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-slate-800 hover:border-brand-500/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="text-[11px] font-mono font-bold text-brand-600 dark:text-brand-400 mb-1">
                Module #{art.data.seriesOrder} &bull; {art.data.readingTimeMinutes} min read
              </div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug">
                <a href={formatUrl(`/articles/${art.id.replace(/\.(md|mdx)$/, '')}`)}>
                  {art.data.title}
                </a>
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                {art.data.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold">
              <a href={formatUrl(`/articles/${art.id.replace(/\.(md|mdx)$/, '')}`)} class="text-brand-600 dark:text-brand-400">
                Read Comparative Analysis &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
