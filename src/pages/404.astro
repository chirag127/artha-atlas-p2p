---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatUrl } from '../lib/urls';
---

<BaseLayout
  title="Page Not Found (404) — ArthaAtlas P2P"
  description="The requested page could not be located on ArthaAtlas P2P."
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="w-16 h-16 rounded-2xl bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center text-2xl font-black mx-auto mb-6">
      404
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mb-2">
      Research Module Not Found
    </h1>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-8 max-w-md mx-auto leading-relaxed">
      The article or resource you requested may have been reorganized within our 10-series taxonomy or moved to a permanent canonical URL.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-bold">
      <a
        href={formatUrl('/')}
        class="px-5 py-2.5 rounded-xl bg-brand-600 text-white hover:bg-brand-500 transition-colors"
      >
        Return to Homepage &rarr;
      </a>
      <a
        href={formatUrl('/articles')}
        class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
      >
        Browse 100 Articles
      </a>
      <a
        href={formatUrl('/calculators')}
        class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
      >
        Financial Calculators
      </a>
    </div>
  </div>
</BaseLayout>
