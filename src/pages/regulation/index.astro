---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatUrl } from '../../lib/urls';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const regulationArticles = allArticles
  .filter((a) => a.data.series === 'rbi-regulation')
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);
---

<BaseLayout
  title="RBI Regulatory Framework & NBFC-P2P Master Directions — ArthaAtlas P2P"
  description="Exhaustive legal and regulatory research covering RBI Master Directions for NBFC-P2P platforms, the landmark August 16, 2024 circular, escrow structures, and statutory lending limits."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Hero Header -->
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-900">
          Regulatory Research Centre
        </span>
        <span class="text-xs text-slate-500">Updated: Circular RBI/2024-25/63</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Indian NBFC-P2P Regulatory Architecture
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300 mt-2 max-w-3xl leading-relaxed">
        Under Section 45-IA of the Reserve Bank of India Act, 1934, all peer-to-peer lending platforms operating in India must be registered as Non-Banking Financial Companies (NBFC-P2P). Explore statutory limits, permitted activities, and the supervisory overhaul enforced in August 2024.
      </p>
    </div>

    <!-- Landmark August 2024 Circular Callout -->
    <div class="p-6 lg:p-8 rounded-2xl bg-amber-50 dark:bg-amber-950/20 border border-amber-300 dark:border-amber-800/60 mb-12">
      <div class="flex items-start gap-4">
        <span class="text-3xl">🏛️</span>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">
              Landmark Supervisory Circular &bull; August 16, 2024
            </span>
          </div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mt-1">
            Review of Master Direction – NBFC-P2P Lending Platforms (RBI/2024-25/63)
          </h2>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 mt-2 leading-relaxed">
            Following extensive supervisory inspections, the RBI cracked down on fintech practices where platforms acted like shadow banks by offering tenure-linked assured returns, auto-pooling mechanisms, and instant liquidity withdrawal structures.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 text-xs">
            <div class="p-3 bg-white/80 dark:bg-navy-900 rounded-xl border border-amber-200 dark:border-amber-900/40">
              <strong class="text-rose-600 dark:text-rose-400 block mb-1">❌ Prohibited</strong>
              Marketing P2P as an assured-return product or providing premature liquidity exit options.
            </div>
            <div class="p-3 bg-white/80 dark:bg-navy-900 rounded-xl border border-amber-200 dark:border-amber-900/40">
              <strong class="text-rose-600 dark:text-rose-400 block mb-1">❌ Prohibited</strong>
              Offering First Loss Default Guarantees (FLDG), credit cushions, or risk guarantees.
            </div>
            <div class="p-3 bg-white/80 dark:bg-navy-900 rounded-xl border border-amber-200 dark:border-amber-900/40">
              <strong class="text-emerald-600 dark:text-emerald-400 block mb-1">✅ Mandated</strong>
              Strict T+1 escrow disbursal, direct bank transfers, and transparent matching policies.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Statutory Ceilings & Permitted Activities Table -->
    <div class="mb-14">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
        Statutory Ceilings & Prudential Norms
      </h2>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-navy-900">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-sans uppercase">
            <tr>
              <th class="px-5 py-3.5">Prudential Metric</th>
              <th class="px-5 py-3.5">Statutory Limit</th>
              <th class="px-5 py-3.5">Legal Basis & Mandatory Requirements</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-200">
            <tr>
              <td class="px-5 py-3 font-sans font-bold">Aggregate Lender Exposure</td>
              <td class="px-5 py-3 font-bold text-brand-600 dark:text-brand-400">₹50,00,000 (₹50 Lakh)</td>
              <td class="px-5 py-3 text-slate-500 font-sans">Across all NBFC-P2P platforms combined.</td>
            </tr>
            <tr>
              <td class="px-5 py-3 font-sans font-bold">Net Worth Certification</td>
              <td class="px-5 py-3 font-bold text-amber-600 dark:text-amber-400">&gt; ₹10,00,000 (₹10 Lakh)</td>
              <td class="px-5 py-3 text-slate-500 font-sans">Requires CA certificate confirming minimum net worth of ₹50 Lakh.</td>
            </tr>
            <tr>
              <td class="px-5 py-3 font-sans font-bold">Single Borrower Exposure</td>
              <td class="px-5 py-3 font-bold text-rose-600 dark:text-rose-400">₹50,000 Maximum</td>
              <td class="px-5 py-3 text-slate-500 font-sans">No lender can lend more than ₹50k to one borrower across all platforms.</td>
            </tr>
            <tr>
              <td class="px-5 py-3 font-sans font-bold">Borrower Aggregate Debt</td>
              <td class="px-5 py-3 font-bold">₹10,00,000 (₹10 Lakh)</td>
              <td class="px-5 py-3 text-slate-500 font-sans">Maximum borrowing cap for any single borrower across all P2P platforms.</td>
            </tr>
            <tr>
              <td class="px-5 py-3 font-sans font-bold">Maximum Loan Tenure</td>
              <td class="px-5 py-3 font-bold text-emerald-600 dark:text-emerald-400">36 Months</td>
              <td class="px-5 py-3 text-slate-500 font-sans">No loan contract can exceed 36 months maturity.</td>
            </tr>
            <tr>
              <td class="px-5 py-3 font-sans font-bold">Net Owned Funds (NOF)</td>
              <td class="px-5 py-3 font-bold">₹2,00,00,000 (₹2 Crore)</td>
              <td class="px-5 py-3 text-slate-500 font-sans">Minimum statutory capital for platform corporate registration.</td>
            </tr>
            <tr>
              <td class="px-5 py-3 font-sans font-bold">Escrow Disbursal Timeline</td>
              <td class="px-5 py-3 font-bold text-brand-600 dark:text-brand-400">T+1 Day</td>
              <td class="px-5 py-3 text-slate-500 font-sans">Committed lender funds must disburse to borrower within T+1 day.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Regulation Series Modules Grid -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">
            10 Researched Regulatory Modules
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Peer-reviewed articles deconstructing every section of the RBI Master Directions.
          </p>
        </div>
        <a href={formatUrl('/series/rbi-regulation')} class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">
          View Complete Series &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {regulationArticles.map((art) => (
          <div class="p-5 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-slate-800 hover:border-brand-500/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="text-[11px] font-mono font-bold text-brand-600 dark:text-brand-400 mb-1">
                Module #{art.data.seriesOrder} &bull; {art.data.readingTimeMinutes} min read
              </div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug">
                <a href={formatUrl(`/articles/${art.id.replace(/\.(md|mdx)$/, '')}`)}>
                  {art.data.title}
                </a>
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                {art.data.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold">
              <a href={formatUrl(`/articles/${art.id.replace(/\.(md|mdx)$/, '')}`)} class="text-brand-600 dark:text-brand-400">
                Read Legal Analysis &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
