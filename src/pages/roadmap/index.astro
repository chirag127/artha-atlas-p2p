---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EDITORIAL_ROADMAP } from '../../data/roadmap';
import { CONTENT_SERIES } from '../../data/taxonomy';
import { formatUrl } from '../../lib/urls';

const publishedCount = EDITORIAL_ROADMAP.filter((t) => t.status === 'Published').length;
const plannedCount = EDITORIAL_ROADMAP.filter((t) => t.status === 'Planned').length;
---

<BaseLayout
  title="310-Topic Editorial Roadmap & Research Pipeline — ArthaAtlas P2P"
  description="Comprehensive 310-topic research roadmap across 10 series covering Indian peer-to-peer lending, NBFC-P2P regulations, quantitative credit underwriting, and judicial precedents."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Hero Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-900 mb-3">
        Long-Term Research Architecture &bull; 310 Topics
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        The Complete P2P Research Roadmap
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2">
        A transparent, multi-phase research curriculum establishing India’s most exhaustive peer-to-peer lending knowledge base.
      </p>
    </div>

    <!-- Metrics Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white dark:bg-navy-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs uppercase font-semibold text-slate-500 dark:text-slate-400">Total Curriculum</div>
        <div class="text-3xl font-extrabold font-mono text-slate-900 dark:text-white mt-1">
          {EDITORIAL_ROADMAP.length}
        </div>
        <div class="text-xs text-slate-500 mt-0.5">Planned & Published Modules</div>
      </div>

      <div class="bg-emerald-50 dark:bg-emerald-950/20 p-5 rounded-2xl border border-emerald-200/60 dark:border-emerald-900/40">
        <div class="text-xs uppercase font-semibold text-emerald-700 dark:text-emerald-400">Phase 1 Complete</div>
        <div class="text-3xl font-extrabold font-mono text-emerald-700 dark:text-emerald-300 mt-1">
          {publishedCount}
        </div>
        <div class="text-xs text-emerald-600 dark:text-emerald-400 mt-0.5">100 Live Researched Articles</div>
      </div>

      <div class="bg-blue-50 dark:bg-blue-950/20 p-5 rounded-2xl border border-blue-200/60 dark:border-blue-900/40">
        <div class="text-xs uppercase font-semibold text-blue-700 dark:text-blue-400">Phases 2 & 3 Pipeline</div>
        <div class="text-3xl font-extrabold font-mono text-blue-700 dark:text-blue-300 mt-1">
          {plannedCount}
        </div>
        <div class="text-xs text-blue-600 dark:text-blue-400 mt-0.5">Specialized Future Research</div>
      </div>

      <div class="bg-white dark:bg-navy-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="text-xs uppercase font-semibold text-slate-500 dark:text-slate-400">Taxonomy Series</div>
        <div class="text-3xl font-extrabold font-mono text-slate-900 dark:text-white mt-1">
          {CONTENT_SERIES.length}
        </div>
        <div class="text-xs text-slate-500 mt-0.5">Structured Thematic Tracks</div>
      </div>
    </div>

    <!-- Filter Controls -->
    <div class="mb-8 p-4 bg-white dark:bg-navy-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Search Topics</label>
          <input
            id="roadmap-search"
            type="text"
            placeholder="Search keywords..."
            class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Filter by Status</label>
          <select id="status-filter" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:outline-none">
            <option value="all">All Statuses ({EDITORIAL_ROADMAP.length})</option>
            <option value="Published">Published ({publishedCount})</option>
            <option value="Planned">Planned Pipeline ({plannedCount})</option>
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Filter by Series</label>
          <select id="series-filter" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:outline-none">
            <option value="all">All 10 Series</option>
            {CONTENT_SERIES.map((s) => (
              <option value={s.slug}>{s.title}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Complexity</label>
          <select id="complexity-filter" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white focus:outline-none">
            <option value="all">All Levels</option>
            <option value="Introductory">Introductory</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Advanced">Advanced</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Roadmap Table / List -->
    <div class="bg-white dark:bg-navy-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 uppercase font-semibold">
            <tr>
              <th class="px-4 py-3.5">ID</th>
              <th class="px-4 py-3.5">Topic & Summary</th>
              <th class="px-4 py-3.5">Series Track</th>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5">Complexity</th>
              <th class="px-4 py-3.5 text-right">Access</th>
            </tr>
          </thead>
          <tbody id="roadmap-tbody" class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-200">
            {EDITORIAL_ROADMAP.map((topic) => {
              const seriesObj = CONTENT_SERIES.find((s) => s.slug === topic.series);
              return (
                <tr
                  class="roadmap-row hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors"
                  data-title={topic.title.toLowerCase()}
                  data-summary={topic.summary.toLowerCase()}
                  data-status={topic.status}
                  data-series={topic.series}
                  data-complexity={topic.complexity}
                >
                  <td class="px-4 py-3 font-mono font-bold text-slate-400">
                    {topic.id}
                  </td>
                  <td class="px-4 py-3 max-w-md">
                    <div class="font-bold text-slate-900 dark:text-white leading-snug">
                      {topic.title}
                    </div>
                    <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-1">
                      {topic.summary}
                    </div>
                  </td>
                  <td class="px-4 py-3 text-slate-600 dark:text-slate-300 font-medium">
                    {seriesObj ? seriesObj.title : topic.series}
                  </td>
                  <td class="px-4 py-3">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${
                      topic.status === 'Published'
                        ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800'
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'
                    }`}>
                      {topic.status === 'Published' ? '✓ Published' : '⏳ Planned'}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-semibold ${
                      topic.complexity === 'Advanced' ? 'text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/30' :
                      topic.complexity === 'Intermediate' ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/30' :
                      'text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800'
                    }`}>
                      {topic.complexity}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    {topic.status === 'Published' ? (
                      <a
                        href={formatUrl(`/articles/`)}
                        class="text-brand-600 dark:text-brand-400 font-bold hover:underline"
                      >
                        Read &rarr;
                      </a>
                    ) : (
                      <span class="text-slate-400 italic text-[11px]">In Pipeline</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById('roadmap-search');
  const statusFilter = document.getElementById('status-filter');
  const seriesFilter = document.getElementById('series-filter');
  const complexityFilter = document.getElementById('complexity-filter');
  const rows = document.querySelectorAll('.roadmap-row');

  function filterRoadmap() {
    const q = searchInput?.value.toLowerCase().trim() || '';
    const st = statusFilter?.value || 'all';
    const se = seriesFilter?.value || 'all';
    const cx = complexityFilter?.value || 'all';

    rows.forEach((row) => {
      const title = row.getAttribute('data-title') || '';
      const summary = row.getAttribute('data-summary') || '';
      const status = row.getAttribute('data-status') || '';
      const series = row.getAttribute('data-series') || '';
      const complexity = row.getAttribute('data-complexity') || '';

      const matchQ = !q || title.includes(q) || summary.includes(q);
      const matchSt = st === 'all' || status === st;
      const matchSe = se === 'all' || series === se;
      const matchCx = cx === 'all' || complexity === cx;

      if (matchQ && matchSt && matchSe && matchCx) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  searchInput?.addEventListener('input', filterRoadmap);
  statusFilter?.addEventListener('change', filterRoadmap);
  seriesFilter?.addEventListener('change', filterRoadmap);
  complexityFilter?.addEventListener('change', filterRoadmap);
</script>
